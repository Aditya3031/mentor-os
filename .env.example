# Copy to .env.local and fill in.
# All variables here are optional - FocusFlow runs locally with no backend.

# --- Optional: canonical deployed URL for Open Graph / social metadata ---
NEXT_PUBLIC_SITE_URL=https://focusflow-h9ct.vercel.app

# --- Optional: Supabase auth + cloud sync ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Optional: Gemini AI study coach ---
# Server-only. Do not prefix with NEXT_PUBLIC.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Optional: Firebase (alternative to Supabase) ---
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=

# --- Optional: real "studying now" counter via your backend ---
NEXT_PUBLIC_PRESENCE_WS_URL=

# --- Optional: Groq fallback for quiz generation (free tier) ---
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
